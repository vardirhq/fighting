script Player {
    @export let speed: f32 = 5.0;
    var facing_right: bool = true;
    var moving: bool = false;
    var idle: Entity = null;
    var walk: Entity = null;

    fn start() {
        this.idle = World.find("Agnes Idle");
        this.walk = World.find("Agnes Walk");
        show();
    }

    fn update(dt: f32) {
        let keys = Vec2(
            Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight"),
            Input.axis("S", "W") + Input.axis("ArrowDown", "ArrowUp")
        );
        let thumb = Vec2(Stick.x, -Stick.y);
        var move = keys;
        if Stick.held && thumb.length > move.length {
            move = thumb;
        }
        if move.length > 1.0 {
            move = move.normalized;
        }

        this.moving = move.length > 0.05;
        if move.x > 0.05 { this.facing_right = true; }
        if move.x < -0.05 { this.facing_right = false; }

        this.transform.position.x += move.x * this.speed * dt;
        this.transform.position.y += move.y * this.speed * dt;
        this.transform.position.x = max(-8.6, min(8.6, this.transform.position.x));
        this.transform.position.y = max(-3.6, min(-1.0, this.transform.position.y));

        let size = abs(this.transform.scale.x);
        if this.facing_right { this.transform.scale.x = size; }
        else { this.transform.scale.x = -size; }

        show();
    }

    fn show() {
        World.set_active(this.idle, !this.moving);
        World.set_active(this.walk, this.moving);
    }
}

script Player {
    @export let speed: f32 = 5.0;
    var facing_right: bool = true;
    var moving: bool = false;

    fn update(dt: f32) {
        let dx = Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight");
        let dy = Input.axis("S", "W") + Input.axis("ArrowDown", "ArrowUp");

        this.moving = abs(dx) > 0.0 || abs(dy) > 0.0;
        if dx > 0.0 { this.facing_right = true; }
        if dx < 0.0 { this.facing_right = false; }

        this.transform.position.x += dx * this.speed * dt;
        this.transform.position.y += dy * this.speed * dt;
        this.transform.position.x = max(-8.6, min(8.6, this.transform.position.x));
        this.transform.position.y = max(-3.6, min(-1.0, this.transform.position.y));

        let wanted = if this.moving { "walk" } else { "idle" };
        if Animation.clip(this.entity) != wanted { Animation.play(this.entity, wanted); }

        // Mirror the right-facing PixelLab art for leftward movement.
        let size = abs(this.transform.scale.x);
        if this.facing_right { this.transform.scale.x = size; }
        else { this.transform.scale.x = -size; }
    }
}

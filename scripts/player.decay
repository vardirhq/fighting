script Player {
    @export let speed: f32 = 5.0;
    @export let fighter_name: String = "Agnes";
    @export let opponent_name: String = "Dad";
    @export let primary_controls: bool = true;
    @export let starts_facing_right: bool = true;
    var facing_right: bool = true;
    var opponent: Entity = null;
    var walking_backwards: bool = false;
    var state: f32 = 0.0;
    var shown: Entity = null;
    var idle_left: Entity = null;
    var idle_right: Entity = null;
    var start_left: Entity = null;
    var start_right: Entity = null;
    var move_left: Entity = null;
    var move_right: Entity = null;
    var stop_left: Entity = null;
    var stop_right: Entity = null;
    var turn: Entity = null;
    var attack_left: Entity = null;
    var attack_right: Entity = null;
    var attack_button: Entity = null;
    var step_dust: Entity = null;
    var attack_sparks: Entity = null;
    var step_cooldown: f32 = 0.0;
    var attack_sparked: bool = false;

    fn start() {
        this.facing_right = this.starts_facing_right;
        this.opponent = World.find(this.opponent_name);
        update_facing();
        this.idle_left = World.find(this.fighter_name + " Idle Left");
        this.idle_right = World.find(this.fighter_name + " Idle Right");
        this.start_left = World.find(this.fighter_name + " Start Left");
        this.start_right = World.find(this.fighter_name + " Start Right");
        this.move_left = World.find(this.fighter_name + " Move Left");
        this.move_right = World.find(this.fighter_name + " Move Right");
        this.stop_left = World.find(this.fighter_name + " Stop Left");
        this.stop_right = World.find(this.fighter_name + " Stop Right");
        this.turn = World.find(this.fighter_name + " Turn");
        this.attack_left = World.find(this.fighter_name + " Attack Left");
        this.attack_right = World.find(this.fighter_name + " Attack Right");
        this.attack_button = World.find("Attack Button");
        this.step_dust = World.find("Step Dust");
        this.attack_sparks = World.find("Attack Sparks");
        to_idle();
    }

    fn update(dt: f32) {
        this.step_cooldown = max(0.0, this.step_cooldown - dt);
        var move_x = Input.axis("J", "L");
        if this.primary_controls {
            move_x = Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight");
            if Stick.held && abs(Stick.x) > abs(move_x) { move_x = Stick.x; }
        }
        move_x = max(-1.0, min(1.0, move_x));
        let wants_left = move_x < -0.05;
        let wants_right = move_x > 0.05;
        let wants_move = wants_left || wants_right;
        var attack = Input.just_pressed("I");
        if this.primary_controls {
            attack = Input.just_pressed("Space") || Ui.is_pressed(this.attack_button);
        }

        // Facing follows the opponent, never the input. At an exact tie keep
        // the previous side so overlapping fighters do not flicker.
        let previous_facing = this.facing_right;
        update_facing();
        if this.facing_right != previous_facing {
            // A side change takes priority even during an attack.
            this.state = 4.0;
            if this.facing_right { show(this.turn, "left_to_right"); }
            else { show(this.turn, "right_to_left"); }
            return;
        }

        if this.state == 4.0 {
            if Animation.is_finished(this.shown) {
                if wants_move { begin_move(); }
                else { to_idle(); }
            }
            return;
        }

        if this.state == 5.0 {
            if !this.attack_sparked && Animation.frame(this.shown) >= 3.0 {
                var reach = -0.95;
                if this.facing_right { reach = 0.95; }
                Effects.burst_at(this.attack_sparks,
                    this.transform.position.x + reach, this.transform.position.y + 1.7);
                this.attack_sparked = true;
            }
            if Animation.is_finished(this.shown) { to_idle(); }
            return;
        }

        if attack {
            this.state = 5.0;
            this.attack_sparked = false;
            if this.facing_right { show(this.attack_right, "attack_right"); }
            else { show(this.attack_left, "attack_left"); }
            return;
        }

        // Turning is a brief pivot in place. The turn branches above return
        // before translation, including the frame that starts a new turn.
        // Start, loop and stop clips still move immediately with held input.
        if wants_move {
            let previous_x = this.transform.position.x;
            this.transform.position.x += move_x * this.speed * dt;
            this.transform.position.x = max(-8.6, min(8.6, this.transform.position.x));
            if this.transform.position.x != previous_x && this.step_cooldown <= 0.0 {
                Effects.burst_at(this.step_dust,
                    this.transform.position.x, this.transform.position.y + 0.05);
                this.step_cooldown = 0.14;
            }
        }

        if this.state == 1.0 {
            if !wants_move {
                begin_stop();
                return;
            }
            if Animation.is_finished(this.shown) {
                begin_loop(move_x);
            }
            return;
        }

        if this.state == 3.0 {
            if wants_move { begin_move(); }
            else if Animation.is_finished(this.shown) { to_idle(); }
            return;
        }

        if wants_move {
            if this.state == 0.0 { begin_move(); }
            else if this.state == 2.0 { begin_loop(move_x); }
        } else if this.state == 2.0 {
            begin_stop();
        }
    }

    fn update_facing() {
        if this.opponent != null {
            let separation = this.opponent.transform.position.x - this.transform.position.x;
            if separation > 0.0 { this.facing_right = true; }
            else if separation < 0.0 { this.facing_right = false; }
        }
    }

    fn begin_move() {
        this.state = 1.0;
        if this.facing_right { show(this.start_right, "start_right"); }
        else { show(this.start_left, "start_left"); }
    }

    fn begin_loop(move_x: f32) {
        let backwards = (move_x < 0.0 && this.facing_right)
            || (move_x > 0.0 && !this.facing_right);
        if this.state == 2.0 && backwards == this.walking_backwards { return; }
        this.state = 2.0;
        this.walking_backwards = backwards;
        if this.facing_right {
            if backwards { show(this.move_right, "back_right"); }
            else { show(this.move_right, "move_right"); }
        } else {
            if backwards { show(this.move_left, "back_left"); }
            else { show(this.move_left, "move_left"); }
        }
    }

    fn begin_stop() {
        this.state = 3.0;
        if this.facing_right { show(this.stop_right, "stop_right"); }
        else { show(this.stop_left, "stop_left"); }
    }

    fn to_idle() {
        this.state = 0.0;
        if this.facing_right { show(this.idle_right, "idle_right"); }
        else { show(this.idle_left, "idle_left"); }
    }

    fn show(entity: Entity, clip: String) {
        if this.shown != null { World.set_active(this.shown, false); }
        this.shown = entity;
        World.set_active(entity, true);
        Animation.play(entity, clip);
        Animation.restart(entity);

        // The projected silhouettes use this pose's sheet and clock. Their
        // parent controls visibility, so hiding the pose hides its shadow too.
        var shadow_name = this.fighter_name + " Shadow " + clip;
        if entity == this.move_left { shadow_name = this.fighter_name + " Shadow move_left"; }
        if entity == this.move_right { shadow_name = this.fighter_name + " Shadow move_right"; }
        if entity == this.turn { shadow_name = this.fighter_name + " Shadow turn"; }
        for i in 0..9 {
            let shadow = World.find(shadow_name + " " + i);
            Animation.play(shadow, clip);
            Animation.restart(shadow);
        }
    }
}
